Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Dados, segredos, repositório e artefatos internos nunca devem ser servidos.
RewriteRule ^(?:dados|private|\.git)(?:/|$) - [F,L,NC]
RewriteRule ^(?:auth-config|private-config|session-security|security)\.php$ - [F,L,NC]
RewriteRule ^(?:visitas|mapa)/central-config\.php$ - [F,L,NC]
RewriteRule ^mapa/config\.php$ - [F,L,NC]
RewriteRule ^diagnostico[^/]*\.php$ - [F,L,NC]
RewriteRule \.(?:sqlite|sqlite3|db|bak|backup|sql|log|ini|env|zip|tar|gz|7z|md|txt)$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
